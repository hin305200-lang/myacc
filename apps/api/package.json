{
  "name": "@nexus-trade/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register --ignore-watch node_modules src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && npx esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate-from-sqlite": "ts-node --transpile-only --require tsconfig-paths/register scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^7.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "6.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.12.12",
    "better-sqlite3": "^11.7.0",
    "esbuild": "^0.25.0",
    "prisma": "6.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.6.3"
  }
}
