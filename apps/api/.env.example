NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Production CORS (comma-separated). Defaults include barrattcookelimited.com when unset in production.
# CORS_ORIGINS=https://barrattcookelimited.com,https://www.barrattcookelimited.com

# Supabase Postgres (Project Settings → Database)
# Project ref: fuefkgitvfkvmkyttxzc  |  Region: ap-northeast-1
# Pooled connection — use for the running API (PgBouncer, port 6543)
DATABASE_URL="postgresql://postgres.fuefkgitvfkvmkyttxzc:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler — Prisma migrations / DIRECT_URL (port 5432 on pooler host)
DIRECT_URL="postgresql://postgres.fuefkgitvfkvmkyttxzc:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Optional: Supabase project URL + publishable key (server-side helpers only; never service_role in git)
SUPABASE_URL=https://fuefkgitvfkvmkyttxzc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# One-time SQLite → Postgres migration (optional)
SQLITE_DATABASE_PATH="./dev.db"

# Legacy SQLite (before migration)
# DATABASE_URL="file:./dev.db"
