# Local development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Production (Vercel → Environment Variables)
# Option A — direct API URL (Render/Railway), recommended:
# NEXT_PUBLIC_API_URL=https://myacc-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://myacc-api.onrender.com
#
# Option B — same-origin proxy (also set server-only API_PROXY_TARGET to the same API URL):
# API_PROXY_TARGET=https://myacc-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://myacc-api.onrender.com
#
# NEXT_PUBLIC_ENABLE_DEMO_AUTOLOGIN=false

NEXT_PUBLIC_DEMO_EMAIL=demo@nexus.trade
NEXT_PUBLIC_DEMO_PASSWORD=password123

# Supabase — use the publishable key (Dashboard → Project Settings → API Keys)
# Never put the service_role key in the web app or in GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://fuefkgitvfkvmkyttxzc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server-only for /backend auth + account (Vercel Environment Variables)
# DATABASE_URL=postgresql://USER.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://USER.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# JWT_SECRET=generate-a-long-random-string
